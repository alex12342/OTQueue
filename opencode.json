{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "codebase-memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "codebase-memory-mcp"
      ],
      "enabled": true,
      "environment": {
        "AUTO_INDEX": "true"
      }
    }
  }
}
