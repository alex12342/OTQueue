# OTQue Environment Configuration
# Copy this file to .env and fill in the values

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/otqueue

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g., "http://localhost:5173,https://otqueue.example.com")
# Use "*" for development to allow all origins
CORS_ORIGIN=*

# ── CSRF Protection ──────────────────────────────────────────────────────────
# Secret used for CSRF token generation (generate a random value in production)
# CSRF_SECRET=

# ── Session ──────────────────────────────────────────────────────────────────
# Session cookie settings (handled by cookie-parser + express-session)
# SESSION_SECRET=

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ── Email Configuration ──────────────────────────────────────────────────────
# SMTP settings for sending emails (password resets, user invites, etc.)
# Set EMAIL_HOST to enable email functionality
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=noreply@yourdomain.com
# Set to "false" to accept self-signed certificates (not recommended for production)
# EMAIL_TLS_REJECT_UNAUTHORIZED=true

# ── App URL ──────────────────────────────────────────────────────────────────
# Base URL of the application (used for password reset links in emails)
# APP_URL=http://localhost

# ── SSO / OAuth ──────────────────────────────────────────────────────────────
# Enable SSO login (set to "true" to activate)
# SSO_ENABLED=false

# SSO provider (currently only "google" is supported)
# SSO_PROVIDER=google

# Google OAuth credentials (register at https://console.cloud.google.com/apis/credentials)
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=

# Restrict login to a specific email domain (e.g., "example.com")
# SSO_ALLOWED_DOMAIN=

# Require explicit email whitelist (must be in sso-whitelist.json on disk)
# SSO_ALLOW_WHITELIST=false

# Path to the SSO whitelist JSON file (default: /app/data/sso-whitelist.json)
# SSO_WHITELIST_FILE=/app/data/sso-whitelist.json
