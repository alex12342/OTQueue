# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings
.playwright-mcp/
tests/e2e/.auth/
otqueue-backup/

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Environment files (contain secrets — never commit; keep *.example templates committed)
.env
.env.*
!.env.example
!.env.*.example

# Caches
.cache/
.local/
.cortexkit/
.opencode/

# Local release helper (reads credentials from .env.release — never commit)
scripts/release.sh
# Local release history appended by scripts/release.sh (git tags are the source of truth)
/RELEASES.md

# Local-only tooling and docs (not required by the app or its build)
/tests/
/playwright.config.ts
opencode.json
AGENTS.md
test-results/
playwright-report/
