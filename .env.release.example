# Credentials for scripts/release.sh — copy to .env.release and fill in.
#   cp .env.release.example .env.release
# .env.release is git-ignored; this template is committed (no real secrets).

# Docker Hub — used for `docker login` and image push.
DOCKERHUB_USER=alex12342
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxx   # Access Token from hub.docker.com/settings/security

# GitHub — GH_TOKEN is used by the `gh` CLI (release creation) and as a
# fallback for pushing the tag. Create at:
# https://github.com/settings/tokens  (scope: repo; fine-grained also works)
GITHUB_USER=alex12342
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
